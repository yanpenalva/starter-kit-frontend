# Development environment configuration
# Copy to `.env` or `.env.local` for local development. Never commit `.env*` secrets.
#
# Root origin of the independent Laravel API (no path or trailing slash).
# Must be allowed in Laravel's cors.php and sanctum.php (SANCTUM_STATEFUL_DOMAINS).
VITE_APP_ENV=development
VITE_API_URL=http://localhost:8000
