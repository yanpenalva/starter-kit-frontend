# Copy to `.env` for local development. Never commit `.env` (gitignored).
# This file contains non-secret defaults only.
#
# Root origin of the independent Laravel API (no path or trailing slash).
# Validated fail-closed at client creation: http/https only, no
# embedded credentials, no query string or fragment. The Vite dev server
# (http://localhost:5173) talks to the API cross-origin; the API side must
# allow the SPA origin in its CORS/sanctum stateful configuration.
VITE_API_URL=http://localhost:8000
