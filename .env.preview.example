# Preview environment configuration (PR preview deployments, GitHub Pages / Netlify / Vercel / Surge)
# Used by CI preview workflows. NEVER point to a production API.
#
# Root origin of the staging, mock, or ephemeral preview Laravel API.
# The preview SPA origin must be registered in the preview API's
# SANCTUM_STATEFUL_DOMAINS and cors.php allowed_origins.
VITE_APP_ENV=preview
VITE_API_URL=https://staging-api.starterkit.com
