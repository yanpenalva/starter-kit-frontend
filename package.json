{
  "name": "starter-kit-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "vite",
    "predev:mock": "node scripts/check-dev-deps.mjs",
    "dev:mock": "VITE_MOCK_API=1 vite",
    "build": "npm run client:check && vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "smoke:browser": "node scripts/smoke-browser.mjs",
    "smoke:auth": "node scripts/smoke-auth-browser.mjs",
    "smoke:verify": "node scripts/smoke-verify-browser.mjs",
    "contract:verify": "python3 scripts/verify_contract.py",
    "client:generate": "node scripts/generate-client.mjs",
    "client:check": "npm run client:generate && node scripts/check-client-generated.mjs",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\" \"scripts/**/*.{mjs,html}\" package.json tsconfig.json vite.config.ts eslint.config.ts orval.config.ts index.html",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css}\" \"scripts/**/*.{mjs,html}\" package.json tsconfig.json vite.config.ts eslint.config.ts orval.config.ts index.html",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/dm-serif-display": "5.3.0",
    "@quasar/extras": "2.1.0",
    "@tanstack/vue-query": "5.104.2",
    "axios": "1.20.0",
    "pinia": "4.1.0",
    "quasar": "2.35.1",
    "vue": "3.5.44",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@mswjs/interceptors": "0.45.9",
    "@quasar/vite-plugin": "2.0.2",
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-vue": "6.0.9",
    "@vitest/coverage-v8": "5.0.3",
    "@vue/test-utils": "2.5.1",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.12.0",
    "eslint-plugin-vue": "10.11.1",
    "jsdom": "30.1.2",
    "msw": "3.0.3",
    "orval": "8.40.0",
    "prettier": "3.9.10",
    "sass-embedded": "1.105.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.13"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "vue-demi@0.14.10": true,
    "fsevents@2.3.3": false
  }
}
